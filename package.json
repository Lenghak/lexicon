{
  "name": "@rhbbcp/products",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format:config": "oxfmt --disable-nested-config \"**/*.{json,jsonc,json5,yaml,yml,toml}\"",
    "format:config:check": "oxfmt --disable-nested-config --check \"**/*.{json,jsonc,json5,yaml,yml,toml}\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "hooks:install": "lefthook install",
    "hooks:validate": "lefthook validate",
    "hooks:pre-commit": "lefthook run pre-commit",
    "prepare": "lefthook install",
    "postCreateCommand": "bun install && bun run hooks:install"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/gitlab": "^13.3.3",
    "gitleaks": "^1.0.0",
    "lefthook": "^2.1.10",
    "nx": "^23.1.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.75.0",
    "semantic-release": "^25.0.8"
  },
  "packageManager": "bun@3.1.14"
}
