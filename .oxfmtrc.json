{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.nx/cache/**",
    "**/.nx/workspace-data/**",
    "**/.gradle/**",
    "**/generated/**",
    "**/generated-sources/**",
    "**/pnpm-lock.yaml"
  ],
  "printWidth": 100,
  "semi": true,
  "singleQuote": true,
  "sortPackageJson": true,
  "sortImports": true,
  "singleAttributePerLine": true,
  "sortTailwindcss": true,
  "vueIndentScriptAndStyle": true,
  "insertFinalNewline": true,
  "objectWrap": "collapse",
  "svelte": { "allowShorthand": false, "indentScriptAndStyle": true },
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false
}
